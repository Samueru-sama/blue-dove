# cpal reaches the sound server through an ALSA plugin rather than by
# linking it, so quick-sharun never detects the stack and DEPLOY_PULSE
# stays off.
DEPLOY_PULSE=1

# winit reaches the Wayland stack by name at run time, so the tracer does
# not see it. The common toolkit set brings libwayland-client,
# libwayland-cursor, libwayland-egl and libxkbcommon alongside the X11
# libraries already deployed.
DEPLOY_COMMON_LIBS=1
